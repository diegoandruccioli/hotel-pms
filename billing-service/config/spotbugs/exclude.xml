<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-specific SpotBugs exclusions for billing-service.

  (RedisNonceStore's own EI_EXPOSE_REP2 exclude now lives in
  internal-auth-lib's config/spotbugs/exclude.xml — the class moved there.)
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <!--
      UrF on vatBreakdownCalculator in these two test classes: the field is a
      Mockito @Spy used only for @InjectMocks wiring — Mockito assigns it into
      the service under test via reflection, so it is never dereferenced
      directly in test code. SpotBugs' static analysis cannot see that usage.
    -->
    <Match>
        <Class name="com.hotelpms.billing.service.impl.FatturaPAServiceImplTest"/>
        <Field name="vatBreakdownCalculator"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
    <Match>
        <Class name="com.hotelpms.billing.service.impl.PdfInvoiceServiceImplTest"/>
        <Field name="vatBreakdownCalculator"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
</FindBugsFilter>
