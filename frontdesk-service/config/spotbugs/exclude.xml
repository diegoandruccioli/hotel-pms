<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-specific SpotBugs exclusions for frontdesk-service.

  EI_EXPOSE_REP2 on AlloggiatiWebSenderServiceImpl:
  The RestOperations field is a Spring-managed singleton injected via constructor DI.
  A defensive copy is not applicable for HTTP client beans — the same shared instance
  is intentionally reused across requests. This pattern is idiomatic in Spring Boot.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <Match>
        <Class name="com.hotelpms.frontdesk.stays.service.impl.AlloggiatiWebSenderServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      RedisNonceStore's own EI_EXPOSE_REP2 exclude now lives in
      internal-auth-lib's config/spotbugs/exclude.xml — the class moved there.
    -->
    <!--
      NP_LOAD_OF_KNOWN_NULL_VALUE on the generated RoomMapperImpl:
      RoomResponse.resolvedTotalPrice has no source on the Room entity (it's
      attached afterward, only by the availability search — see
      RoomMapper.toResponse's @Mapping(ignore = true)). MapStruct's generated
      code always declares an ignored target as a local `= null` and passes it
      straight into the constructor; SpotBugs reads that as "known null passed
      to constructor". This is MapStruct's normal codegen shape for any ignored
      target with no source, not a null-safety bug in code we wrote.
    -->
    <Match>
        <Class name="com.hotelpms.frontdesk.rooms.mapper.RoomMapperImpl"/>
        <Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/>
    </Match>
    <!--
      NP_LOAD_OF_KNOWN_NULL_VALUE on the generated StayMapperImpl:
      StayResponse.cityTaxWarning has no source on the Stay entity (E18 follow-up —
      it's attached afterward, only on the check-in response, by
      StayServiceImpl#withCityTaxWarning). Same MapStruct codegen shape as
      RoomMapperImpl above, same false positive.
    -->
    <Match>
        <Class name="com.hotelpms.frontdesk.stays.mapper.StayMapperImpl"/>
        <Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/>
    </Match>
</FindBugsFilter>
