<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-specific SpotBugs exclusions for notification-service.

  EI_EXPOSE_REP2 on NotificationServiceImpl: templateEngine is a Spring-managed
  Thymeleaf singleton bean injected via constructor DI — same rationale as
  RedisNonceStore's own exclude, which now lives in internal-auth-lib's
  config/spotbugs/exclude.xml since the class moved there.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <Match>
        <Class name="com.hotelpms.notification.service.impl.NotificationServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
